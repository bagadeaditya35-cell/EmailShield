# EmailShield environment variables. PLACEHOLDERS ONLY. Never commit a real .env.
# Most settings are managed in the app (Settings / Monitoring); these override defaults.

# Where data lives (default: your user profile). Leave unset unless you know you need it.
# EMAILSHIELD_DATA_DIR=C:\Users\<you>\AppData\Roaming\EmailShield

# Local web server (127.0.0.1 only unless you explicitly allow remote access)
EMAILSHIELD_PORT=8731
# EMAILSHIELD_ALLOW_REMOTE=false
# EMAILSHIELD_HOST=127.0.0.1
# EMAILSHIELD_API_KEY=<generate-a-long-random-value-here>

# Limits
EMAILSHIELD_MAX_EML_MB=10
EMAILSHIELD_RETENTION_DAYS=90
EMAILSHIELD_MIN_FREE_MB=200

# Optional integrations (all OFF by default). Prefer the in-app secret store over putting tokens in the environment.
EMAILSHIELD_TI_ENABLED=false
# VIRUSTOTAL_API_KEY=<your-key>
# GOOGLE_SAFE_BROWSING_API_KEY=<your-key>
# SPLUNK_HEC_TOKEN=<your-hec-token>
